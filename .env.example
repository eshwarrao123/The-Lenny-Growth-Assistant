# ==============================================================================
# The Lenny Growth Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# DO NOT commit .env containing real production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# [Required] Environment mode: 'development', 'staging', or 'production'
APP_ENV=development
# [Required] Backend bind host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# [Required] Connection coordinates for the PostgreSQL container or instance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny

# [Optional] Async SQLAlchemy connection URL override
# If omitted, constructed automatically from POSTGRES_* parameters above.
# For local development outside Docker, use: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/lenny

# ------------------------------------------------------------------------------
# 3. VECTOR EMBEDDINGS (pgvector & nomic-embed-text)
# ------------------------------------------------------------------------------
# [Required] Dimensionality of the vector embeddings.
# Must match the model: 768 for nomic-embed-text, 1536 for OpenAI text-embedding-3-small.
PGVECTOR_DIMENSIONS=768

# ------------------------------------------------------------------------------
# 4. LOCAL LLM & EMBEDDING PROVIDER (Ollama)
# ------------------------------------------------------------------------------
# [Required for local mode] Ollama API endpoint.
# From inside Docker (Linux/Mac/Windows): http://host.docker.internal:11434
# When running locally outside Docker:   http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# [Required for local mode] Model for chat reasoning & Ship 30 generation
OLLAMA_MODEL=qwen2.5:7b

# [Required for local mode] Model for semantic search vector embeddings (768d)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 5. CLOUD LLM PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# [Optional] OpenAI Configuration (fallback/alternative cloud provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# [Optional] Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 6. RAG RETRIEVAL PIPELINE
# ------------------------------------------------------------------------------
# [Required] Transcript chunking and similarity parameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 7. SESSIONS & ARTIFACTS
# ------------------------------------------------------------------------------
# [Required] Session persistence TTL in days
SESSION_TTL_DAYS=30

# [Required] Maximum artifact payload size in bytes (default: 5MB = 5,242,880)
ARTIFACT_MAX_BYTES=5242880

# ------------------------------------------------------------------------------
# 8. CORS & FRONTEND URLS
# ------------------------------------------------------------------------------
# [Required] Allowed CORS origins for the FastAPI backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# [Required for Frontend] Public API endpoint accessed by the browser client
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 9. SECURITY & SECRETS
# ------------------------------------------------------------------------------
# [Required] Application secret key for session signing and internal cryptography
SECRET_KEY=dev-secret-change-in-production

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & TIMEOUTS
# ------------------------------------------------------------------------------
# [Optional] Logging verbosity: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# [Optional] Timeout for local LLM generation in seconds (calibrated for CPU execution)
OLLAMA_TIMEOUT_SECONDS=300.0

# [Optional] Database connection acquisition timeout in seconds
DB_TIMEOUT_SECONDS=30.0